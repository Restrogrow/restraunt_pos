# Environment files
.env
.env.local
*.env
!*.env.example

# Logs
*.log
logs/
tmp/

# Database dumps (keep full_database_dump.sql for migration)
*.sql
!database/*.sql
!full_database_dump.sql
backups_fake_orders_*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Uploads (keep structure)
uploads/*
!uploads/.gitkeep

# Local menu image library (uploaded directly to the server, not tracked in git)
images/

# Logs
logs/*
!logs/.gitkeep

# CLI migration scripts (may contain credentials)
migrate_*_cli.php

# Dev-session artifacts (debug dumps, scratch automation scripts)
_debug_*
_fix_*
_apply_*
_verify_*
main/nul

# Temporary files
tmp/*
!tmp/.gitkeep

# Composer (if added later)
vendor/
composer.lock

# Node modules (if added later)
node_modules/
package-lock.json

# Playwright test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Session files — .htaccess is tracked deliberately (it's what blocks this
# folder from being served over HTTP at all); everything else in it is
# live session data and must never be committed.
main/sessions/*
!main/sessions/.htaccess

# Test files
test_*.php
*_test.php

nul
composer.phar

# The browser app demo's fonts and icons live in a folder named node_modules inside its web build
!app-demo/app/assets/node_modules/
!app-demo/app/assets/node_modules/**/vendor/

# The customer app browser demo: fonts and icons live in a folder named node_modules inside its web build
!customer-app-demo/app/assets/node_modules/
!customer-app-demo/app/assets/node_modules/**/vendor/
# Local-only build of the same demo (base path /menuwebsite/)
customer-app-demo-local/
# Local-only build of the Partner app demo (base path /menuwebsite/)
app-demo-local/
# Staff app and Super Admin app browser builds: fonts and icons live in a folder named node_modules inside the web build
!staff-app-demo/app/assets/node_modules/
!staff-app-demo/app/assets/node_modules/**/vendor/
!superadmin-app-web/app/assets/node_modules/
!superadmin-app-web/app/assets/node_modules/**/vendor/
# Local-only copies of those builds (base path /menuwebsite/)
staff-app-demo-local/
superadmin-app-web-local/
# Blog images are uploaded on the server (Super Admin > Blog); only the folder's guards are in git
main/uploads/blog/*
!main/uploads/blog/.htaccess
!main/uploads/blog/index.php
main/config/.ga-service-account.json

# signatures made in Super Admin › Email (kept in the database too)
main/uploads/signatures/*
# small photo copies made by main/website/image.php
main/uploads/cache/*
# …except what Gemini wrote down about the images/ photo library (includes/menu_image_catalogue.php).
# It is the same library on every server, so it is built once and travels with the code — otherwise
# each server would have to spend half an hour and a few hundred Gemini calls rebuilding it.
!main/uploads/cache/menu-images/
main/uploads/cache/menu-images/*
!main/uploads/cache/menu-images/catalogue.json
!main/uploads/cache/menu-images/.htaccess

# Super Admin call recordings: private, stay on the server only
main/uploads/lead_recordings/
# menus new owners sent from a sign-up link (config/signup_invites.php): private, stay on the server only
main/uploads/signup_menus/
# room photos owners upload on the Rooms page (config/rooms.php): stay on the server only
main/uploads/rooms/

# Local Android build output of the order-watch module
app/modules/order-watch/android/build/

# Built Partner app (~88 MB each): it goes to the Play Console, not into git
*.apk

# One-off PHP written during a dev session and run against the live database —
# probes, data fixes, migrations. Nothing in the app calls them, and the db-*
# ones hold production credentials. Same reason as migrate_*_cli.php above; the
# test_*.php rule there misses these because they are spelled with hyphens.
app/db-*.php
app/fake-orders-*.php
app/inject-*.php
app/run-*-migration.php
app/test-*.php
