# Basic Configuration
RewriteEngine On
# PhonePe's webhook sends Authorization: SHA256(username:password); keep it visible to PHP on every host
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Internal files are for the team, not the public website: README, docs and notes (the admin
# handbook lists emails and setup details), database dumps, logs and the test setup.
<FilesMatch "\.(md|sql|log)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(package(-lock)?\.json|playwright\.config\.js)$">
    Require all denied
</FilesMatch>
# PHP's own error log files (Hostinger writes "error_log" next to the script): server paths and errors
<FilesMatch "^(error_log|php_errorlog|php_error\.log)$">
    Require all denied
</FilesMatch>
RewriteRule ^(docs|tests|scripts)(/|$) - [F,L]
# One address for Google: www.restrogrow.com pages redirect to restrogrow.com (Search Console showed
# both copies in results). Only page views (GET/HEAD) move; API calls (/api/v1), webhooks and the MCP/OAuth
# endpoints keep working on www so nothing that posts to www breaks.
RewriteCond %{HTTP_HOST} ^www\.restrogrow\.com$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(main|mcp|api|\.well-known)(/|$)
RewriteRule ^(.*)$ https://restrogrow.com/$1 [R=301,L]

# AI apps (ChatGPT, Claude): the MCP server and its OAuth discovery documents (main/mcp, main/oauth)
RewriteRule ^mcp/?$ main/mcp/server.php [L]
# Developer REST API with owners' API keys (main/api/v1/index.php, docs at /developers)
RewriteRule ^api/v1/?(.*)$ main/api/v1/index.php?route=$1 [L,QSA]
RewriteRule ^\.well-known/oauth-protected-resource(/mcp)?/?$ main/oauth/metadata.php?doc=resource [L]
RewriteRule ^\.well-known/(oauth-authorization-server|openid-configuration)(/.*)?$ main/oauth/metadata.php?doc=server [L]

# Private sign-up links from Super Admin › Sign-up links (config/signup_invites.php)
RewriteRule ^join/([a-z0-9]{6,16})/?$ /main/admin/login.php?tab=signup&invite=$1 [R=302,L]

# Allow direct access to admin/api scripts (main/ directory)
RewriteRule ^main/ - [L]

# Restaurant own-domain robots.txt / sitemap.xml (these exist as files for restrogrow.com itself)
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^restrogrow\.com$ [NC]
RewriteCond %{HTTP_HOST} !^www\.restrogrow\.com$ [NC]
RewriteCond %{HTTP_HOST} !hstgr\.io$ [NC]
RewriteCond %{HTTP_HOST} !\.ngrok-free\.(app|dev)$ [NC]
RewriteRule ^(robots\.txt|sitemap\.xml)$ main/website/custom-domain.php [L]

# Custom domain handling — route non-main-domain requests to front controller
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^restrogrow\.com$ [NC]
RewriteCond %{HTTP_HOST} !^www\.restrogrow\.com$ [NC]
RewriteCond %{HTTP_HOST} !hstgr\.io$ [NC]
RewriteCond %{HTTP_HOST} !\.ngrok-free\.(app|dev)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ main/website/custom-domain.php [L,QSA]

# Clean URLs - Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteCond %{REQUEST_URI} \.html$
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Add .html extension internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Website analytics script (our own tracking + GA4 ID from Super Admin › Website analytics)
RewriteRule ^assets/rg-analytics\.js$ main/api/rg_analytics_js.php [L]

# Clean URLs for pages
RewriteRule ^about/?$ about/index.html [L]
# Blog (managed in Super Admin › Blog; blog/*.php)
RewriteRule ^blog/_layout\.php$ - [F,L]
RewriteRule ^blog/?$ blog/index.php [L,QSA]
RewriteRule ^blog/feed\.xml$ blog/feed.php [L]
RewriteRule ^blog/category/([a-z0-9-]+)/?$ blog/index.php?category=$1 [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]
RewriteRule ^sitemap-blog\.xml$ blog/sitemap.php [L]
RewriteRule ^faq/?$ faq/index.html [L]
RewriteRule ^privacy-policy/?$ privacy-policy/index.html [L]
RewriteRule ^terms-of-service/?$ terms-of-service/index.html [L]
RewriteRule ^cookie-policy/?$ cookie-policy/index.html [L]

# SEO sitemaps (main/website/sitemap.php)
RewriteRule ^sitemap-restaurants\.xml$ main/website/sitemap.php?index=1 [L]
RewriteRule ^([a-z0-9-]+)/sitemap\.xml$ main/website/sitemap.php?restaurant=$1 [L,QSA]

# Tracked short links from campaigns, posters, QR codes and Google posts (main/website/go.php, config/link_tracking.php)
RewriteRule ^([a-z0-9-]+)/go/([A-Za-z0-9]{4,12})$ main/website/go.php?c=$2 [L,QSA]

# Restaurant links that changed: the old address keeps its Google traffic (301 to the new one)
# Pin Point Family Restaurant moved from /new-pin-point-family-restaurant (42 Google clicks, then 404 on 17 Oct 2026)
RewriteRule ^new-pin-point-family-restaurant(/.*)?$ /pin-point-family-restaurant$1 [R=301,L]

# Restaurant short URLs (e.g., /restaurant-name)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ main/website/index.php?restaurant=$1 [L,QSA]

# Restaurant sub-pages (e.g., /restaurant-name/menu, /restaurant-name/cart, etc.)
# Individual rules per page for maximum compatibility (avoids $2 backreference issues)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/menu$ main/website/menu.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/cart$ main/website/cart.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/about$ main/website/about.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/contact$ main/website/contact.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/profile$ main/website/profile.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/login$ main/website/login.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/reset-password$ main/website/reset_password.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/track$ main/website/track.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/privacy-policy$ main/website/privacy-policy.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/terms-of-service$ main/website/terms-of-service.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/refund-policy$ main/website/refund-policy.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/shipping-policy$ main/website/shipping-policy.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/cookie-policy$ main/website/cookie-policy.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/plans$ main/website/plans.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/subscribe$ main/website/subscribe.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/my-subscription$ main/website/my-subscription.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/catering$ main/website/catering.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/loyalty$ main/website/loyalty.php?restaurant=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/reservations$ main/website/reservations.php?restaurant=$1 [L,QSA]

# Main domain catch-all — route any unmatched requests on restrogrow.com/localhost through custom-domain.php
RewriteCond %{HTTP_HOST} ^restrogrow\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.restrogrow\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^localhost(:\d+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^127\.0\.0\.1(:\d+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} \.ngrok-free\.(app|dev)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ main/website/custom-domain.php [L,QSA]

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(\.htaccess|\.git|\.env|config\.php)$">
    Require all denied
</FilesMatch>

# Set default charset
AddDefaultCharset UTF-8
