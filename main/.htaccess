# RestroGrow POS - Main Application Directory
# This directory contains all application files

# Allow access to all files
Options -Indexes

# Security: Prevent direct access to sensitive files (Apache 2.4+ compatible)
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

# Security: Block .env, .env.local, .git, and any other dotfile from being
# served directly — these hold live DB/SMTP/PhonePe credentials and must
# never be reachable over HTTP even if the URL is guessed.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Defense in depth: one-time migration/DB-fix scripts must never run from an
# anonymous web request. Each script also self-guards via
# config/maintenance_guard.php (CLI or logged-in admin session), but blocking
# them here means the request never even reaches PHP.
<FilesMatch "^(add_[a-z_]+_column|add_country_tax_columns|add_critical_indexes|add_subcategories|check_variations_table|fix_[a-z_]+|run_[a-z_]+)\.php$">
    Require all denied
</FilesMatch>

# PHP Settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

