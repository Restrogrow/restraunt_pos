# Database Configuration
# For remote access (when not on Hostinger server)
DB_HOST_REMOTE=your-remote-db-host.com
# For local access (when on Hostinger server or localhost)
DB_HOST_LOCAL=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Email/SMTP Configuration
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Restaurant POS System

# PhonePe Payment Gateway Configuration
PHONEPE_ENVIRONMENT=test
PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID
PHONEPE_SALT_KEY=your_salt_key_here
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL_TEST=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_BASE_URL_PRODUCTION=https://api.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost/menu/phonepe_callback.php
PHONEPE_REDIRECT_URL=http://localhost/menu/dashboard.php
PHONEPE_DEMO_MODE=true

# Geoapify Address Autocomplete (free tier: 3,000 requests/day)
# Get your free API key at https://www.geoapify.com/
GEOAPIFY_API_KEY=f1867f34b02a4ec1a51cf4176635d217

# Google Gemini API (used by Superadmin > Menus > "Generate from Photos")
# Get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
