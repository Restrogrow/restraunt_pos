# Allow image access
<IfModule mod_headers.c>
    # Set proper MIME types for images
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
        Header set Content-Type "image/jpeg"
        Header set Cache-Control "public, max-age=31536000"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Directory listing must stay OFF — this folder holds user-uploaded menu
# photos and payment proofs. +Indexes (the old setting) let anyone browse
# every uploaded filename.
Options -Indexes

# Prevent execution of PHP files in uploads directory (security - Apache 2.4+ compatible)
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

